<!DOCTYPE html>
<html lang="es">

<head>

    <!-- Configuración básica -->
    <meta charset="UTF-8">

    <!-- Título -->
    <title>Login VG MODA</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">


    <!-- ESTILOS -->
    <style>

        /* =========================
           FONDO GENERAL NEGRO
        ========================== */

        body{

            background: black;
            font-family: Arial, sans-serif;

        }


        /* =========================
           TARJETA LOGIN
        ========================== */

        .card{

            border-radius: 20px;
            border: none;
            background: white;

        }

        /* TÍTULO */
        h2{

            font-weight: bold;
            color: black;

        }

        /* INPUTS */
        .form-control{

            background: white;
            border: 1px solid #ccc;
            color: black;
            padding: 12px;

        }

        /* PLACEHOLDER */
        .form-control::placeholder{

            color: #777;

        }

        /* EFECTO */
        .form-control:focus{

            background: white;
            color: black;
            border-color: black;
            box-shadow: none;

        }

        /* BOTÓN INGRESAR */
        .btn-dark{

            background: black;
            border: none;
            padding: 10px;
            font-weight: bold;

        }

    </style>

</head>

<body>


    <!-- =========================
         CONTENEDOR PRINCIPAL
    ========================== -->

    <div class="container">

        <div class="row justify-content-center align-items-center vh-100">

            <div class="col-md-5">


                <!-- Tarjeta -->
                <div class="card shadow p-5">


                    <!-- Título -->
                    <h2 class="text-center mb-5">

                        VG MODA

                    </h2>


                    <!-- Mostrar errores -->
                    <% if (error) { %>

                        <div class="alert alert-danger">

                            <%= error %>

                        </div>

                    <% } %>


                    <!-- Formulario -->
                    <form method="POST">


                        <!-- Usuario -->
                        <input type="text"
                               name="usuario"
                               class="form-control mb-3"
                               placeholder="Usuario"
                               required>


                        <!-- Contraseña -->
                        <input type="password"
                               name="password"
                               class="form-control mb-3"
                               placeholder="Contraseña"
                               required>


                        <!-- Botón ingresar -->
                        <button class="btn btn-dark w-100">

                            Ingresar

                        </button>

                    </form>


                    <!-- Botón registro -->
                    <a href="/registro"
                       class="btn btn-outline-dark w-100 mt-3">

                        Registrarse

                    </a>


                    <!-- Botón volver -->
                    <a href="index.html"
                       class="btn btn-outline-secondary w-100 mt-2">

                        Volver al Inicio

                    </a>

                </div>

            </div>

        </div>

    </div>

</body>
</html>