<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <title>Mi Perfil</title>


    <!-- BOOTSTRAP -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">


    <style>

        body{

            background: black;
            font-family: Arial, sans-serif;

        }


        /* TARJETA MÁS PEQUEÑA */
        .card{

            border-radius: 20px;
            border: none;
            background: white;
            width: 100%;
            max-width: 480px;
            margin: auto;

        }


        h2{

            font-weight: bold;
            color: black;
            font-size: 30px;

        }


        .form-control{

            background: white;
            border: 1px solid #ccc;
            color: black;
            padding: 12px;
            font-size: 15px;

        }


        .form-control:focus{

            background: white;
            color: black;
            border-color: black;
            box-shadow: none;

        }


        .btn-dark{

            background: black;
            border: none;
            padding: 12px;
            font-weight: bold;

        }


        /* MENSAJE */
        .mensaje{

            background: #d1e7dd;
            color: #0f5132;
            padding: 10px;
            border-radius: 10px;
            margin-bottom: 20px;
            text-align: center;
            font-weight: bold;

            animation: desaparecer 2s forwards;

        }


        /* ANIMACIÓN */
        @keyframes desaparecer {

            0%{

                opacity: 1;

            }

            80%{

                opacity: 1;

            }

            100%{

                opacity: 0;
                visibility: hidden;

            }

        }

    </style>

</head>

<body>


<div class="container">

    <div class="row justify-content-center align-items-center vh-100">

        <div class="col-md-6">


            <!-- TARJETA -->
            <div class="card shadow p-4">


                <!-- TÍTULO -->
                <h2 class="text-center mb-4">

                    Mi Perfil

                </h2>


                <!-- MENSAJE -->
                <% if (mensaje) { %>

                    <div class="mensaje">

                        <%= mensaje %>

                    </div>

                <% } %>


                <!-- FORMULARIO -->
                <form method="POST">


                    <!-- NOMBRE -->
                    <input type="text"
                           name="nombre"
                           class="form-control mb-3"
                           placeholder="Nombre completo"
                           value="<%= datos.nombre_completo %>"
                           required>


                    <!-- CORREO -->
                    <input type="email"
                           name="correo"
                           class="form-control mb-3"
                           placeholder="Correo electrónico"
                           value="<%= datos.email %>"
                           required>


                    <!-- TELÉFONO -->
                    <input type="text"
                           name="telefono"
                           class="form-control mb-3"
                           placeholder="Teléfono"
                           value="<%= datos.telefono %>"
                           required>


                    <!-- USUARIO -->
                    <input type="text"
                           name="usuario"
                           class="form-control mb-3"
                           placeholder="Usuario"
                           value="<%= datos.usuario %>"
                           required>


                    <!-- CONTRASEÑA -->
                    <input type="password"
                           name="password"
                           class="form-control mb-4"
                           placeholder="Nueva contraseña"
                           required>


                    <!-- BOTÓN -->
                    <button type="submit"
                            name="actualizar"
                            class="btn btn-dark w-100">

                        Guardar Cambios

                    </button>

                </form>


                <!-- VOLVER -->
                <a href="/productos"
                   class="btn btn-outline-dark w-100 mt-3">

                    Volver

                </a>

            </div>

        </div>

    </div>

</div>

</body>
</html>