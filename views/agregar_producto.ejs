<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <title>Agregar producto - VG MODA</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>

        body{
            background:#f5f5f5;
            font-family:Arial,sans-serif;
            color:#000;
        }

        .form-card{

            max-width:750px;
            margin:40px auto;
            padding:35px;

            border-radius:25px;

            background:#fff;

            box-shadow:0 8px 25px rgba(0,0,0,0.08);

        }

        .form-card h1{

            font-weight:bold;
            margin-bottom:25px;

        }

        .btn-back{

            color:#000;
            text-decoration:none;

            border:1px solid #000;

            padding:10px 16px;

            border-radius:12px;

            display:inline-block;

            margin-bottom:20px;

        }

        .btn-black{

            background:#000;
            color:#fff;

            border:none;

            border-radius:12px;

            padding:12px 22px;

            font-weight:bold;

        }

        .btn-black:hover{

            background:#222;

        }

        .alert-custom{

            background:#fff;

            border:1px solid #000;

            color:#000;

            border-radius:12px;

        }

        .form-control,
        .form-select{

            border-radius:12px;
            padding:12px;

        }

        .form-control:focus,
        .form-select:focus{

            box-shadow:none;
            border:1px solid #000;

        }

    </style>

</head>

<body>

<div class="container">

    <div class="form-card">

        <a href="/admin"
           class="btn-back">

            ← Volver al panel administrador

        </a>

        <h1>Agregar nuevo producto</h1>

        <% if (mensaje) { %>

            <div class="alert alert-custom mb-4">

                <%= mensaje %>

            </div>

        <% } %>

        <form action="/agregar_producto"
              method="POST"
              enctype="multipart/form-data">

            <!-- NOMBRE -->

            <div class="mb-3">

                <label class="form-label">

                    Nombre del producto

                </label>

                <input type="text"
                       name="nombre_producto"
                       class="form-control"
                       required>

            </div>

            <!-- PRECIO / STOCK / CATEGORÍA -->

            <div class="row g-3 mb-3">

                <!-- PRECIO -->

                <div class="col-md-4">

                    <label class="form-label">

                        Precio (COP)

                    </label>

                    <div class="input-group">

                        <span class="input-group-text">

                            $

                        </span>

                        <input type="number"
                               name="precio"
                               class="form-control"
                               min="1"
                               placeholder="Pesos colombianos"
                               required>

                    </div>

                </div>

                <!-- STOCK -->

                <div class="col-md-4">

                    <label class="form-label">

                        Existencias

                    </label>

                    <input type="number"
                           name="stock"
                           class="form-control"
                           min="1"
                           required>

                </div>

                <!-- CATEGORÍA -->

                <div class="col-md-4">

                    <label class="form-label">

                        Categoría

                    </label>

                    <select name="id_categoria"
                            class="form-select"
                            required>

                        <option value="" selected disabled>

                            Selecciona una categoría

                        </option>

                        <option value="1">Jeans</option>
                        <option value="2">Vestidos</option>
                        <option value="3">Sandalias</option>
                        <option value="4">Bodys</option>
                        <option value="5">Tenis</option>
                        <option value="6">Bolsos</option>

                    </select>

                </div>

            </div>

            <!-- IMAGEN -->

            <div class="mb-4">

                <label class="form-label">

                    Imagen del producto

                </label>

                <input type="file"
                       name="imagen"
                       class="form-control"
                       accept=".jpg,.jpeg,.png,.webp"
                       required>

                <div class="form-text">

                    Solo JPG, PNG o WEBP.

                </div>

            </div>

            <!-- BOTÓN -->

            <button type="submit"
                    class="btn-black">

                Guardar producto

            </button>

        </form>

    </div>

</div>

</body>
</html>