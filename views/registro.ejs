<!DOCTYPE html>
<html lang="es">

<head>

    <!-- Configuración básica -->
    <meta charset="UTF-8">

    <!-- Título -->
    <title>Registro VG MODA</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">


    <!-- ESTILOS -->
    <style>

        /* FONDO NEGRO */
        body{
            background: black;
            font-family: Arial, sans-serif;
        }

        /* TARJETA BLANCA */
        .card{
            border-radius: 20px;
            border: 1px solid #ddd;
            background: white;
        }

        /* TÍTULO */
        h2{
            font-weight: bold;
            color: black;
        }

        /* INPUTS BLANCOS */
        .form-control{
            background: white;
            border: 1px solid #ccc;
            color: black;
            padding: 12px;
        }

        /* PLACEHOLDER */
        .form-control::placeholder{
            color: #777;
        }

        /* EFECTO AL ESCRIBIR */
        .form-control:focus{
            background: white;
            color: black;
            border-color: black;
            box-shadow: none;
        }

        /* BOTÓN NEGRO */
        .btn-dark{
            background: black;
            border: none;
            padding: 10px;
            font-weight: bold;
        }

    </style>

</head>


<body>


    <!-- =========================
         CONTENEDOR PRINCIPAL
    ========================== -->

    <div class="container">

        <div class="row justify-content-center vh-100 align-items-center">

            <div class="col-md-5">


                <!-- Tarjeta formulario -->
                <div class="card shadow p-4">


                    <!-- Título -->
                    <h2 class="text-center mb-4">

                        Registro VG MODA

                    </h2>

                    <% if (error) { %>
                        <div class="alert alert-danger">
                            <%= error %>
                        </div>
                    <% } %>


                    <!-- Formulario -->
                    <form method="POST">


                        <!-- Nombre completo -->
                        <input type="text"
                               name="nombre"
                               class="form-control mb-3"
                               placeholder="Nombre completo"
                               required>


                        <!-- Correo -->
                        <input type="email"
                               name="email"
                               class="form-control mb-3"
                               placeholder="Correo electrónico"
                               required>


                        <!-- Teléfono -->
                        <input type="text"
                               name="telefono"
                               class="form-control mb-3"
                               placeholder="Teléfono"
                               required>


                        <!-- Usuario -->
                        <input type="text"
                               name="usuario"
                               class="form-control mb-3"
                               placeholder="Usuario"
                               required>


                        <!-- Contraseña -->
                        <input type="password"
                               name="password"
                               class="form-control mb-3"
                               placeholder="Contraseña"
                               required>


                        <!-- Botón registro -->
                        <button class="btn btn-dark w-100">

                            Registrarse

                        </button>

                    </form>


                    <!-- Botón volver -->
                    <a href="/login"
                       class="btn btn-outline-dark w-100 mt-3">

                        Volver al login

                    </a>

                </div>

            </div>

        </div>

    </div>

</body>
</html>