<!DOCTYPE html>
<html lang="es">

<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>Editar Producto</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">

<style>

body{

    background:#f5f5f5;
    font-family:Arial;

}

.box{

    width:500px;
    margin:50px auto;
    background:#fff;
    padding:35px;
    border-radius:20px;
    box-shadow:0px 5px 15px rgba(0,0,0,0.1);

}

h2{

    text-align:center;
    margin-bottom:30px;
    font-weight:bold;

}

.form-control{

    border-radius:12px;
    padding:12px;

}

.btn-black{

    background:#000;
    color:#fff;
    border:none;
    padding:12px;
    border-radius:12px;
    width:100%;
    font-weight:bold;

}

.btn-black:hover{

    background:#222;

}

.btn-white{

    background:#fff;
    color:#000;
    border:2px solid #000;
    padding:12px;
    border-radius:12px;
    width:100%;
    text-decoration:none;
    display:block;
    text-align:center;
    margin-top:15px;

}

.btn-white:hover{

    background:#000;
    color:#fff;

}

.mensaje{

    background:#d1e7dd;
    color:#0f5132;
    padding:10px;
    border-radius:10px;
    margin-bottom:20px;
    text-align:center;
    font-weight:bold;

    animation: desaparecer 2s forwards;

}

@keyframes desaparecer {

    0%{
        opacity:1;
    }

    80%{
        opacity:1;
    }

    100%{
        opacity:0;
        visibility:hidden;
    }

}

</style>

</head>

<body>

<div class="box">

    <h2>

        Editar Producto

    </h2>


    <% if (mensaje) { %>

        <div class="mensaje">

            <%= mensaje %>

        </div>

    <% } %>


    <form method="POST">

        <!-- NOMBRE -->

        <div class="mb-3">

            <label>

                Nombre del producto

            </label>

            <input
                type="text"
                name="nombre_producto"
                class="form-control"
                value="<%= producto.nombre_producto %>"
                required
            >

        </div>


        <!-- PRECIO -->

        <div class="mb-3">

            <label>

                Precio

            </label>

            <input
                type="number"
                name="precio"
                class="form-control"
                value="<%= producto.precio %>"
                min="1"
                required
            >

        </div>


        <!-- STOCK -->

        <div class="mb-4">

            <label>

                Stock

            </label>

            <input
                type="number"
                name="stock"
                class="form-control"
                value="<%= producto.stock %>"
                min="1"
                required
            >

        </div>


        <!-- BOTÓN -->

        <button
            type="submit"
            name="guardar"
            class="btn-black"
        >

            Guardar Cambios

        </button>

    </form>


    <!-- VOLVER -->

    <a
        href="/admin"
        class="btn-white"
    >

        Volver al panel

    </a>

</div>

</body>
</html>