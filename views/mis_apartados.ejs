<!DOCTYPE html>
    <html lang="es">

    <head>

        <!-- Configuración básica -->
        <meta charset="UTF-8">

        <!-- Título -->
        <title>Mis Apartados</title>

        <!-- Bootstrap CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
            rel="stylesheet">


        <!-- Estilos internos -->
        <style>

            /* =========================
            ESTILOS GENERALES
            ========================== */

            body{

                background: #f5f5f5;

            }


            /* =========================
            TARJETAS
            ========================== */

            .card{

                border: none;
                border-radius: 20px;
                overflow: hidden;

            }


            /* =========================
            IMÁGENES
            ========================== */

            .card img{

                height: 350px;
                object-fit: cover;

            }


            /* =========================
            BOTONES
            ========================== */

            .btn{

                border-radius: 10px;

            }


            /* =========================
            TÍTULO
            ========================== */

            h1{

                font-weight: bold;

            }

        </style>

    </head>

    <body>


        <!-- =========================
            CONTENEDOR PRINCIPAL
        ========================== -->

        <div class="container py-5">


            <!-- Título -->
            <h1 class="text-center mb-4">

                Mis Apartados

            </h1>


            <!-- Botones superiores -->
            <div class="mb-4 d-flex flex-wrap gap-2">

                <a href="/productos"
                   class="btn btn-dark">

                    Volver

                </a>

            </div>


            <!-- Contenedor tarjetas -->
            <div class="row">


                <!-- Recorrer apartados -->
                <% apartados.forEach((apartado) => { %>


                    <div class="col-md-3 mb-4">

                        <div class="card shadow">


                            <!-- Imagen producto -->
                            <img src="/carpeta-imagenes/<%= apartado.imagen %>"
                                class="card-img-top">


                            <!-- Información producto -->
                            <div class="card-body text-center">


                                <!-- Nombre -->
                                <h5>

                                    <%= apartado.nombre_producto %>

                                </h5>


                                <!-- Precio -->
                                <p class="fs-5">

                                    $ <%= fmt(apartado.precio, ",") %>

                                </p>


                                <!-- Estado -->
                                <p>

                                    Estado:
                                    <b><%= apartado.estado %></b>

                                </p>


                                <!-- Botón eliminar -->
                                <a href="/eliminar_apartado?id=<%= apartado.id_apartado %>"
                                class="btn btn-dark w-100 mt-2">

                                    Eliminar

                                </a>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>

        </div>

    </body>
    </html>