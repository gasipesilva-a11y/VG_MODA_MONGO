<!DOCTYPE html>
<html lang="es">

<head>

    <!-- Configuración básica -->
    <meta charset="UTF-8">

    <!-- Título -->
    <title>Productos VG MODA</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">


    <!-- Estilos internos -->
    <style>

        /* =========================
           ESTILOS GENERALES
        ========================== */

        body{

            background: #fff;
            font-family: Arial, sans-serif;

        }


        /* =========================
           TÍTULO
        ========================== */

        h1{

            font-weight: bold;
            color: #111;

        }


        /* =========================
           TARJETAS PRODUCTOS
        ========================== */

        .card{

            border: none;
            border-radius: 20px;
            overflow: hidden;

            transition: 0.3s;

            background: white;

        }


        /* Hover tarjeta */
        .card:hover{

            transform: translateY(-10px);

            box-shadow: 0px 10px 25px rgba(0,0,0,0.2);

        }


        /* =========================
           IMÁGENES
        ========================== */

        .card img{

            height: 350px;
            object-fit: cover;

        }


        /* =========================
           BOTONES
        ========================== */

        .btn-dark,
        .btn-outline-dark{

            border-radius: 12px;

        }

        .btn-black{

            background: #000;
            color: #fff;
            border-radius: 12px;

        }

        .btn-black:hover{

            background: #111;
            color: #fff;

        }

        .btn-white{

            background: #fff;
            color: #000;
            border: 1px solid #000;
            border-radius: 12px;

        }


        /* Espacio botones categorías */
        .btn-outline-dark{

            margin: 5px;

        }


        /* =========================
           INPUT BUSCADOR
        ========================== */

        input.form-control{

            border-radius: 12px;
            height: 45px;

        }

    </style>

</head>

<body>


    <!-- =========================
         CONTENEDOR PRINCIPAL
    ========================== -->

    <div class="container py-5">


        <!-- Título -->
        <h1 class="text-center">

            Productos VG MODA

        </h1>


        <!-- Bienvenida -->
        <p class="text-center mb-5 fs-5">

            Bienvenido,

            <b>

                <%= sesion.cliente %>

            </b>

        </p>


        <!-- Botones superiores -->
        <div class="text-end mb-4">


            <!-- Panel administrador -->
            <% if (sesion.rol == "admin") { %>

                <a href="/admin"
                   class="btn btn-black">

                    Panel Admin

                </a>

            <% } %>


            <!-- Mis apartados -->
            <a href="/mis_apartados"
               class="btn btn-black">

                Mis Apartados

            </a>

             <!-- Mi Perfil -->
            <a href="/perfil" 
            class="btn btn-dark">
             Mi Perfil
            </a>
            <!-- Cerrar sesión -->
            <a href="/cerrar_sesion"
               class="btn btn-white">

                Cerrar Sesión

            </a>

                

        </div>


        <!-- =========================
             BUSCADOR
        ========================== -->

        <form method="GET"
              class="mb-4">

            <div class="row justify-content-center">

                <div class="col-md-6">

                    <input type="text"
                           name="buscar"
                           class="form-control"
                           placeholder="Buscar producto...">

                </div>

                <div class="col-md-2">

                    <button class="btn btn-dark w-100">

                        Buscar

                    </button>

                </div>

            </div>

        </form>


        <!-- =========================
             CATEGORÍAS
        ========================== -->

        <div class="text-center mb-5">

            <a href="/productos"
               class="btn btn-outline-dark">

                Todos

            </a>

            <a href="/productos?categoria=1"
               class="btn btn-outline-dark">

                Jeans

            </a>

            <a href="/productos?categoria=2"
               class="btn btn-outline-dark">

                Vestidos

            </a>

            <a href="/productos?categoria=3"
               class="btn btn-outline-dark">

                Sandalias

            </a>

            <a href="/productos?categoria=4"
               class="btn btn-outline-dark">

                Bodys

            </a>

            <a href="/productos?categoria=5"
               class="btn btn-outline-dark">

                Tenis

            </a>

            <a href="/productos?categoria=6"
               class="btn btn-outline-dark">

                Bolsos

            </a>

        </div>


        <!-- =========================
             PRODUCTOS
        ========================== -->

        <div class="row">


            <!-- Recorrer productos -->
            <% productos.forEach((producto) => { %>


                <div class="col-md-3 mb-4">

                    <div class="card shadow">


                        <!-- Imagen -->
                        <img src="/carpeta-imagenes/<%= producto.imagen %>"
                             class="card-img-top">


                        <!-- Información -->
                        <div class="card-body text-center">


                            <!-- Nombre -->
                            <h5>

                                <%= producto.nombre_producto %>

                            </h5>


                            <!-- Precio -->
                            <p class="fs-5">

                                $ <%= fmt(producto.precio, ",") %>

                            </p>


                            <!-- Stock -->
                            <p>

                                Stock:
                                <%= producto.stock %>

                            </p>


                            <!-- Validar stock -->
                            <% if (producto.stock > 0) { %>


                                <!-- Formulario apartado -->
                                <form action="/guardar_apartado"
                                      method="POST">

                                    <input type="hidden"
                                           name="id_producto"
                                           value="<%= producto.id_producto %>">

                                    <button class="btn btn-dark w-100">

                                        Apartar

                                    </button>

                                </form>


                            <% } else { %>


                                <!-- Sin stock -->
                                <button class="btn btn-white w-100"
                                        disabled>

                                    Sin stock

                                </button>

                            <% } %>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    </div>

</body>
</html>