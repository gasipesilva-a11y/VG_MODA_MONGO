<!DOCTYPE html>
<html lang="es">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Administrador VG MODA</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">

<style>

body{
    background:#f5f5f5;
    font-family:Arial;
}

.sidebar{
    width:250px;
    height:100vh;
    background:#000;
    position:fixed;
    left:0;
    top:0;
    padding:30px 20px;
}

.logo{
    color:#fff;
    font-size:30px;
    text-align:center;
    font-weight:bold;
    margin-bottom:40px;
}

.sidebar a{
    display:block;
    color:#fff;
    text-decoration:none;
    padding:14px;
    border-radius:12px;
    margin-bottom:10px;
}

.sidebar a:hover{
    background:#fff;
    color:#000;
}

.main{
    margin-left:250px;
    padding:35px;
}

.top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:30px;
}

.card-admin{
    background:#fff;
    border-radius:20px;
    padding:30px;
    margin-bottom:30px;
}

.stats{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:20px;
    margin-bottom:30px;
}

.card-stat{
    background:#fff;
    border-radius:20px;
    padding:25px;
    text-align:center;
}

.card-stat h2{
    font-size:38px;
}

.btn-black{
    background:#000;
    color:#fff;
    padding:10px 20px;
    border:none;
    border-radius:12px;
    text-decoration:none;
}

.btn-white{
    background:#fff;
    color:#000;
    border:2px solid #000;
    padding:10px 20px;
    border-radius:12px;
    text-decoration:none;
}

.btn-white:hover{
    background:#000;
    color:#fff;
}

.form-control,
.form-select{
    border-radius:12px;
    padding:12px;
}

.estado{
    background:#000;
    color:#fff;
    padding:8px 14px;
    border-radius:30px;
}

.table{
    border-radius:18px;
    overflow:hidden;
}

.table thead{
    background:#000;
    color:#fff;
}

</style>

</head>

<body>

<div class="sidebar">

    <div class="logo">
        VG MODA
    </div>

    <a href="#productos">Productos</a>

    <a href="#apartados">Apartados</a>

    <a href="#clientes">Clientes</a>

    <a href="/productos">Ver tienda</a>

    <a href="/cerrar_sesion">Cerrar sesión</a>

</div>

<div class="main">

    <div class="top">

        <h1>Panel Administrador</h1>

        <div>
            <%= sesion.cliente %>
        </div>

    </div>

    <!-- STATS -->

    <div class="stats">

        <div class="card-stat">
            <p>Total apartados</p>
            <h2><%= apartadosTotales %></h2>
        </div>

        <div class="card-stat">
            <p>Pendientes</p>
            <h2><%= apartadosPendientes %></h2>
        </div>

        <div class="card-stat">
            <p>Entregados</p>
            <h2><%= apartadosEntregados %></h2>
        </div>

        <div class="card-stat">
            <p>Clientes</p>
            <h2><%= clientesRegistrados %></h2>
        </div>

    </div>

    <!-- AGREGAR PRODUCTO -->

    <div class="card-admin" id="productos">

        <h2 class="mb-4">
            Agregar producto
        </h2>

        <% if (mensaje) { %>

            <div class="alert alert-danger">
                <%= mensaje %>
            </div>

        <% } %>

        <form
            action="/admin"
            method="POST"
            enctype="multipart/form-data"
        >

            <input
                type="hidden"
                name="agregar_producto"
                value="1"
            >

            <div class="mb-3">

                <label class="form-label">
                    Nombre del producto
                </label>

                <input
                    type="text"
                    name="nombre_producto"
                    class="form-control"
                    required
                >

            </div>

            <div class="row">

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Precio en pesos colombianos
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            COP $
                        </span>

                        <input
                            type="number"
                            name="precio"
                            class="form-control"
                            min="1"
                            required
                        >

                    </div>

                </div>

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Stock disponible
                    </label>

                    <input
                        type="number"
                        name="stock"
                        class="form-control"
                        min="1"
                        required
                    >

                </div>

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Categoría
                    </label>

                    <select
                        name="id_categoria"
                        class="form-select"
                        required
                    >

                        <option value="" selected disabled>
                            Selecciona una categoría
                        </option>

                        <option value="1">Jeans</option>
                        <option value="2">Vestidos</option>
                        <option value="3">Sandalias</option>
                        <option value="4">Bodys</option>
                        <option value="5">Tenis</option>
                        <option value="6">Bolsos</option>

                    </select>

                </div>

            </div>

            <div class="mb-4">

                <label class="form-label">
                    Imagen del producto
                </label>

                <input
                    type="file"
                    name="imagen"
                    class="form-control"
                    accept=".jpg,.jpeg,.png,.webp"
                    required
                >

            </div>

            <button
                type="submit"
                class="btn-black"
            >

                Guardar producto

            </button>

        </form>

    </div>

    <!-- PRODUCTOS -->

   <!-- PRODUCTOS -->

<div class="card-admin">

    <h2 class="mb-4">
        Productos registrados
    </h2>

    <div class="table-responsive">

        <table class="table table-hover">

            <thead>

                <tr>

                    <th>ID</th>
                    <th>Producto</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th>Categoría</th>
                    <th>Editar</th>
                    <th>Eliminar</th>

                </tr>

            </thead>

            <tbody>

            <% productos.forEach((producto) => { %>

                <tr>

                    <td><%= producto.id_corto %></td>

                    <td><%= producto.nombre_producto %></td>

                    <td>
                        COP $
                        <%= fmt(producto.precio, ".") %>
                    </td>

                    <td><%= producto.stock %></td>

                    <td><%= producto.nombre_categoria %></td>


                    <!-- BOTÓN EDITAR -->
                    <td>

                        <a
                            href="/editar_producto?id=<%= producto.id_producto %>"
                            class="btn-black"
                        >

                            Editar

                        </a>

                    </td>


                    <!-- BOTÓN ELIMINAR -->
                    <td>

                        <a
                            href="/eliminar_producto?id=<%= producto.id_producto %>"
                            class="btn-white"
                        >

                            Eliminar

                        </a>

                    </td>

                </tr>

            <% }) %>

            </tbody>

        </table>

    </div>

</div>

    <!-- APARTADOS -->

    <div class="card-admin" id="apartados">

        <h2 class="mb-4">
            Apartados realizados
        </h2>

        <div class="table-responsive">

            <table class="table table-hover">

                <thead>

                    <tr>

                        <th>ID</th>
                        <th>Cliente</th>
                        <th>Producto</th>
                        <th>Precio</th>
                        <th>Estado</th>
                        <th>Fecha</th>
                        <th>Acción</th>

                    </tr>

                </thead>

                <tbody>

                <% apartados.forEach((fila) => { %>

                    <tr>

                        <td><%= fila.id_corto %></td>

                        <td><%= fila.nombre_completo %></td>

                        <td><%= fila.nombre_producto %></td>

                        <td>
                            COP $
                            <%= fmt(fila.precio, ".") %>
                        </td>

                        <td>
                            <span class="estado">
                                <%= fila.estado %>
                            </span>
                        </td>

                        <td><%= fila.fecha_apartado %></td>

                     <td>

    <% if (fila.estado == "Pendiente") { %>

        <a href="/entregar?id=<%= fila.id_apartado %>"
           class="btn-white">

            Entregar

        </a>

    <% } else { %>

        <a href="/eliminar_admin?id=<%= fila.id_apartado %>"
           class="btn-white">

            Eliminar

        </a>

    <% } %>

</td>
                    </tr>

                <% }) %>

                </tbody>

            </table>

        </div>

    </div>

    <!-- CLIENTES -->

    <div class="card-admin" id="clientes">

        <h2 class="mb-4">
            Clientes registrados
        </h2>

        <div class="table-responsive">

            <table class="table table-hover">

                <thead>

                    <tr>

                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Usuario</th>
                        <th>Correo</th>
                        <th>Acción</th>

                    </tr>

                </thead>

                <tbody>

                <% clientes.forEach((cliente) => { %>

                    <tr>

                        <td><%= cliente.id_corto %></td>

                        <td><%= cliente.nombre_completo %></td>

                        <td><%= cliente.usuario %></td>

                        <td><%= cliente.email %></td>

                        <td>

                            <a
                                href="/eliminar_cliente?id=<%= cliente.id_cliente %>"
                                class="btn-white"
                            >

                                Eliminar

                            </a>

                        </td>

                    </tr>

                <% }) %>

                </tbody>

            </table>

        </div>

    </div>

</div>

</body>
</html>